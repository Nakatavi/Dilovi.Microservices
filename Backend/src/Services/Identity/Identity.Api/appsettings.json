{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/identity-.log",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Identity.Api"
    }
  },
  "Jwt": {
    "Issuer": "dilovi-identity",
    "Audience": "dilovi-api",
    "AccessTokenLifetimeMinutes": 15
  },
  "AllowedHosts": "*"
}
